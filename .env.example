# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a GitHub (ya está en .gitignore).

# ── Agente NEXIA ──────────────────────────────────────────────
# Clave de Gemini (https://aistudio.google.com/apikey). Activa el agente con IA
# generativa y la búsqueda web. Sin clave, NEXIA usa el motor local con la misma base.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Base de datos del prototipo (opcional) ───────────────────
# Con DATABASE_URL, NEXIA lee la tabla ofertas_culturales de PostgreSQL.
# Sin ella, usa la base incluida en src/nexia/baseConocimiento.ts.
DATABASE_URL=
# DATABASE_SSL=true   # para bases en la nube que exigen SSL

# Búsqueda vectorial (pgvector). Debe ser el MISMO proveedor que generó los
# embeddings existentes: gemini | openai | ninguno
EMBEDDINGS_PROVEEDOR=ninguno
# OPENAI_API_KEY=
# EMBEDDINGS_MODELO=

# ── Servidor ──────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
